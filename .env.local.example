# Required: Anthropic key for the underwriting agent
ANTHROPIC_API_KEY=sk-ant-...

# Required for "live" Specter signals; if blank, the demo uses curated mocks
SPECTER_API_KEY=
SPECTER_BASE_URL=https://api.tryspecter.com

# Required for the autonomous-agent path via Cursor SDK; if blank, the endpoint
# falls back to the single-pass Anthropic implementation.
CURSOR_API_KEY=

# Xero Custom Connection (client_credentials). Used to fetch real Motorway
# data for the "buy-real-1" invoice. If unset, the buy-real-1 path falls back
# to a hardcoded mock.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
